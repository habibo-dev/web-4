# ── ISLEM Immobilier — environment template ─────────────────────────
# Copy to `.env.local` and adjust. All variables are OPTIONAL:
# the site runs with sensible defaults if nothing is set.

# Admin dashboard (/admin → rewritten to /fr/admin)
# Leave unset to disable the admin panel entirely.
ADMIN_PASSWORD=
# Used to sign the admin session cookie. Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Optional: email notifications for new inquiries / submissions.
# When unset, records are still persisted to data/db.json and shown in /admin.
RESEND_API_KEY=
NOTIFY_EMAIL=contact@islemimmobilier.dz

# Optional: public site URL used for canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
